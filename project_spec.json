{
  "project_name": "NetraPath",
  "full_name": "City-Wide AI Engine for Multi-Camera ANPR, Trajectory Tracking and Urban Traffic Analytics",
  "version": "1.0.0-mvp",
  "status": "MVP Prototype (Flask + Vanilla JS)",
  "target": "SIH 2026 Final Round",
  "problem_statement": "SIH 2026 — Problem Statement 26127",
  "organisation": "Bharat Electronics Limited (BEL)",
  "prepared": "November 2026",
  "description": "NetraPath transforms a city's existing CCTV/ANPR camera network from isolated detection points into a unified, privacy-aware urban mobility intelligence system. Current repo is a working Flask MVP with in-memory data, vanilla JS dashboard, and 28 REST endpoints. Production architecture (FastAPI, React, PostgreSQL, Kafka) is documented in docs/ folder.",
  "core_requirements": [
    "High-accuracy ANPR and OCR engine (target >= 90% plate recognition on diverse test set)",
    "Single-plate trajectory reconstruction across multiple cameras with GIS route visualisation",
    "Macro-level traffic flow analytics, congestion heatmaps, and real-time blacklist alerting"
  ],
  "actual_tech_stack_mvp": {
    "backend": "Python + Flask",
    "ai_cv": "YOLOv8 (Ultralytics) + PaddleOCR/RapidOCR + OpenCV",
    "frontend": "Vanilla JS + Leaflet.js (single-page, 700 lines)",
    "data_store": "In-memory Python dicts",
    "maps": "Leaflet 1.9 + OpenStreetMap/CARTO",
    "video": "OpenCV + MJPEG streaming",
    "entry_point": "python run_mvp.py",
    "port": 5000
  },
  "production_tech_stack_target": {
    "backend": "FastAPI 0.111+",
    "frontend": "React 18 + TypeScript",
    "database": "PostgreSQL 16 + PostGIS 3.4",
    "cache": "Redis 7",
    "event_streaming": "Apache Kafka 3.7+",
    "containerisation": "Docker Compose"
  },
  "implemented_features": [
    "YOLOv8 vehicle + plate detection",
    "PaddleOCR / RapidOCR",
    "Indian plate regex validation (I/1, O/0 correction)",
    "Temporal OCR fusion (weighted voting)",
    "Multi-camera trajectory linking (haversine + speed check)",
    "Watchlist + blacklist alerts",
    "Traffic heatmap",
    "Camera health monitoring",
    "City-scale 5,000 camera simulation",
    "Fleet simulator (5,000 cameras)",
    "MJPEG live streams (traffic + webcam)",
    "Async video upload with progress tracking",
    "OCR lab (image upload → plate text)",
    "Analytics (counts, speed, flow, OD matrix)",
    "28 REST API endpoints"
  ],
  "not_implemented_mvp": [
    "FastAPI (using Flask)",
    "React frontend (using vanilla JS)",
    "PostgreSQL/PostGIS (using in-memory)",
    "Kafka (using in-memory queue)",
    "Redis (using Python dict)",
    "JWT/RBAC (using role toggle)",
    "WebSocket (using REST polling)",
    "ByteTrack (single-frame detection)",
    "CLAHE enhancement (basic crop)",
    "Docker (direct run)"
  ],
  "api_endpoints_count": 28,
  "operating_modes": ["LIVE (RTSP/webcam streams)", "REPLAY (pre-recorded .mp4 files)", "SIMULATION (generated synthetic events)"],
  "dashboard_pages_mvp": [
    "Login / Role Toggle",
    "Home / Overview (stat tiles + mini map)",
    "Plate Search & Trajectory (route on map + sighting list)",
    "Live Alerts + Watchlist",
    "Traffic Heatmap + Camera Health"
  ],
  "alert_types": [
    {"type": "BLACKLIST", "trigger": "Plate hash matches active watchlist entry", "priority": "Must-have"},
    {"type": "CAMERA_DOWN", "trigger": "No camera heartbeat for > 5 minutes", "priority": "Must-have"},
    {"type": "GEOFENCE", "trigger": "Detection within configured polygon", "priority": "Nice-to-have"},
    {"type": "WRONG_WAY", "trigger": "Vehicle direction conflicts with road segment", "priority": "Nice-to-have"},
    {"type": "SPEED_VIOLATION", "trigger": "Calculated speed exceeds threshold", "priority": "Nice-to-have"},
    {"type": "CLONED_PLATE", "trigger": "Same plate at two impossible locations", "priority": "Nice-to-have"},
    {"type": "ROUTE_ANOMALY", "trigger": "Trajectory route_confidence below threshold", "priority": "Nice-to-have"}
  ],
  "risk_score_formula": "0.40*B + 0.25*C + 0.20*R + 0.15*Q",
  "risk_score_levels": {"CRITICAL": ">= 0.75", "HIGH": "0.55-0.74", "MEDIUM": "0.35-0.54", "LOW": "< 0.35"},
  "rbac_roles": {"VIEWER": "Heatmaps + camera counts", "TRAFFIC_OFFICER": "Alerts + watchlist", "INVESTIGATOR": "Full trajectory search", "ADMIN": "All operations"},
  "sih_sprint_plan": {
    "0-2h": "Setup — Flask running, dashboard loads",
    "2-6h": "YOLO detection — vehicles + plates detected",
    "6-10h": "OCR + validation — plate text extracted",
    "10-14h": "Trajectory engine — cross-camera route on map",
    "14-18h": "Dashboard core — map + search + alerts",
    "18-22h": "Heatmap + analytics — density overlay + OD counts",
    "22-26h": "Watchlist + review + demo data",
    "26-30h": "Polish — error handling, loading states",
    "30-34h": "Demo rehearsal — full run-through x3",
    "34-36h": "Buffer — backup video, final commit"
  },
  "must_have_features": [
    "Working ANPR on 2-3 video clips",
    "Multi-camera trajectory on map (WOW moment)",
    "Blacklist alert firing live",
    "Heatmap updating during replay",
    "Camera health status",
    "Low-confidence review queue"
  ],
  "nice_to_have_features": [
    "OD matrix chart",
    "Cloned plate detection demo",
    "RBAC login screen",
    "Wrong-way detection"
  ],
  "wow_moment": "Type a plate number → watch the vehicle's entire journey draw itself as an animated line across 3-4 cameras on a Leaflet map, with timestamps and evidence thumbnails at each stop, then a blacklist alert fires in real-time.",
  "evaluation_metrics_targets": {
    "plate_detection_precision": ">= 90%",
    "plate_recognition_clear": ">= 90%",
    "plate_recognition_adverse": ">= 70%",
    "camera_to_camera_linking": ">= 85%",
    "alert_latency": "< 5s end-to-end",
    "duplicate_suppression": ">= 80%",
    "trajectory_display_time": "< 3s"
  },
  "privacy_compliance": {
    "framework": "DPDP Act 2023 + DPDP Rules 2025",
    "plate_hashing": "HMAC-SHA256",
    "plate_storage": "AES-256 encrypted (production)",
    "rbac": "4 roles: VIEWER, TRAFFIC_OFFICER, INVESTIGATOR, ADMIN",
    "audit_logging": "Immutable audit_logs (production)"
  },
  "documentation": {
